{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://doclekjmatfrgaykjrze.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "edutrack-mcp",
      "version": "0.1.0",
      "title": "EduTrack"
    },
    "tools": [
      {
        "name": "ask_eduai",
        "title": "Ask EduAI Study Buddy",
        "description": "Ask the EduTrack EduAI tutor an academic question (UP Board, NDA prep, or B.Tech/B.Sc/B.A syllabus).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "The student's question."
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_colleges",
        "title": "List supported colleges",
        "description": "Return the curated list of Indian higher-education institutions supported by EduTrack. Optionally filter by a case-insensitive substring.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional substring filter, case-insensitive."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max results to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_syllabus_subjects",
        "title": "List syllabus subjects",
        "description": "Return the subjects tracked by EduTrack's Exam Portal & PYQs module.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
